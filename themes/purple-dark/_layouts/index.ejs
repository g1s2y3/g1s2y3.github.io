<%- partial('_partials/header') %>

<main class="main">
  <div class="container">
    <div class="content-wrapper">
      <!-- Posts -->
      <section class="content">
        <% if (page.total > 1) { %>
          <!-- Pagination -->
          <%- partial('_partials/pagination', {
            prev_text: __('prev'),
            next_text: __('next')
          }) %>
        <% } %>

        <% page.posts.each(function(post) { %>
        <article class="post">
          <h2 class="post-title">
            <a href="<%- url_for(post.path) %>"><%= post.title %></a>
          </h2>

          <div class="post-meta">
            <span><i class="far fa-calendar"></i> <%= post.date.format('YYYY-MM-DD') %></span>
            <% if (post.categories.length > 0) { %>
              <span><i class="far fa-folder"></i> <%- post.categories.map(function(category) {
                return '<a href="' + category.path + '">' + category.name + '</a>';
              }).join(' / ') %></span>
            <% } %>
            <% if (post.tags.length > 0) { %>
              <span><i class="far fa-tags"></i> <%- post.tags.map(function(tag) {
                return '<a href="' + tag.path + '" class="tag">' + tag.name + '</a>';
              }).join(' ') %></span>
            <% } %>
          </div>

          <div class="post-content">
            <% if (post.excerpt) { %>
              <%- post.excerpt %>
              <div class="read-more">
                <a href="<%- url_for(post.path) %>" class="btn">阅读全文</a>
              </div>
            <% } else if (post.content.length > 300) { %>
              <%- post.content.substring(0, 300) %>...
              <div class="read-more">
                <a href="<%- url_for(post.path) %>" class="btn">阅读全文</a>
              </div>
            <% } else { %>
              <%- post.content %>
            <% } %>
          </div>
        </article>
        <% }); %>

        <% if (page.total > 1) { %>
          <!-- Pagination -->
          <%- partial('_partials/pagination', {
            prev_text: __('prev'),
            next_text: __('next')
          }) %>
        <% } %>
      </section>

      <!-- Sidebar -->
      <%- partial('_partials/sidebar') %>
    </div>
  </div>
</main>

<%- partial('_partials/footer') %>