<%- partial('_partials/header') %>

<main class="main">
  <div class="container">
    <div class="content-wrapper">
      <!-- Post Content -->
      <article class="content">
        <%- partial('_partials/post/article') %>

        <!-- Comments -->
        <% if (theme.theme_config.enable_comments && theme_comment && theme_comment.render) { %>
        <%- partial('_partials/comments') %>
        <% } %>
      </article>

      <!-- Sidebar -->
      <% if (theme.theme_config.layout !== 'right') { %>
      <%- partial('_partials/sidebar') %>
      <% } %>
    </div>
  </div>
</main>

<%- partial('_partials/footer') %>

<%- js('js/toc') %>